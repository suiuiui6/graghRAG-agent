{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/prevent-destructive-commands.py\"",
            "statusMessage": "检查命令安全性…"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "developer-kit@developer-kit": true,
    "developer-kit-python@developer-kit": true,
    "developer-kit-typescript@developer-kit": true,
    "developer-kit-devops@developer-kit": true,
    "developer-kit-ai@developer-kit": true
  }
}
