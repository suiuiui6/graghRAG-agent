# ============================================================
# MinerU MVP 测试 — 环境变量配置（模板）
# 复制此文件为 .env 并填入实际值
# ============================================================

MINERU_API_TOKEN=your-token-here
MINERU_API_BASE_URL=https://mineru.net/api/v4/extract/task

# 方式 A：公网可访问的文件 URL（填写后跳过上传步骤）
FILE_URL=

# 方式 B：本地 PDF 文件路径（将自动上传获取公网 URL）
LOCAL_PDF_PATH=./sample.pdf

LANGUAGE=ch
IS_OCR=false
ENABLE_FORMULA=true
ENABLE_TABLE=true
MODEL_VERSION=pipeline
OUTPUT_DIR=./output
MAX_WAIT_SECONDS=300
POLL_INTERVAL_SECONDS=3
